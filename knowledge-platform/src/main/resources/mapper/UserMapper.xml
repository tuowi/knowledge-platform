<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.itheima.knowledge_platform.mapper.UserMapper">


    <update id="update" parameterType="com.itheima.knowledge_platform.pojo.entity.User">
        update user
        <set>
            <if test="password != null">password=#{password},</if>
            <if test="email != null">email=#{email},</if>
            <if test="avatar != null">avatar=#{avatar},</if>
            <if test="status != null">status=#{status},</if>
        </set>
        where id=#{id}
    </update>


    <select id="selectByUser" resultType="com.itheima.knowledge_platform.pojo.entity.User">
        select * from user
        <where>
            <if test="username != null">
                username like concat('%',#{username},'%')
            </if>
            <if test="status != null">
                and status=#{status}
            </if>
            <if test="email != null">
                and email=#{email}
            </if>
        </where>
        order by created_at desc
    </select>
</mapper>
