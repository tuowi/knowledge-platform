<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.itheima.knowledge_platform.mapper.PlatformAdminMapper">


    <update id="updateById" parameterType="com.itheima.knowledge_platform.pojo.entity.PlatformAdmin">
        update platform_admin
        <set>
            <if test="status != null">status=#{status},</if>
            <if test="adminPwd != null">admin_pwd=#{adminPwd},</if>
            <if test="adminType != null">admin_type=#{adminType},</if>
        </set>
        where id=#{id}
    </update>

    <select id="selectByPlatformAdmin" resultType="com.itheima.knowledge_platform.pojo.entity.PlatformAdmin"
            parameterType="com.itheima.knowledge_platform.pojo.entity.PlatformAdmin">
        select * from platform_admin
        <where>
            <if test="adminType != null">
                admin_type=#{adminType}
            </if>
            <if test="adminAccount != null">
                and admin_account like concat('%',#{adminAccount},'%')
            </if>
        </where>
    </select>

</mapper>