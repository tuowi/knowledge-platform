<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.itheima.knowledge_platform.mapper.CategoryMapper">


    <select id="selectByTeamId" resultType="com.itheima.knowledge_platform.pojo.entity.Category">
        SELECT id, parent_id, name, team_id, sort_order
        FROM category
        WHERE team_id = #{teamId}
        ORDER BY sort_order ASC
    </select>
</mapper>
